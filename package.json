{
  "name": "ultreia",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@azure/ai-projects": "^2.2.0",
    "@azure/identity": "^4.13.1",
    "@expo/metro-runtime": "~56.0.15",
    "@turf/turf": "^7.4.0",
    "dotenv": "^17.4.2",
    "expo": "~56.0.12",
    "expo-battery": "~56.0.4",
    "expo-location": "~56.0.18",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "geojson-path-finder": "^2.1.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react-native": "^1.46.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "react-native": "0.85.3",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "data:build-towns": "node scripts/build-camino-towns.mjs",
    "data:geocode": "node scripts/geocode-camino-data.mjs",
    "data:build-map": "npm run data:validate && node scripts/build-map-data.mjs",
    "test:map-data": "node --test scripts/map-data-source.test.mjs",
    "test:demo": "npm run data:validate && NODE_PATH=./node_modules node --test scripts/demo.test.mjs",
    "data:audit-map": "npm run data:validate && NODE_PATH=./node_modules node scripts/audit-map-data.mjs",
    "data:build-map-assets": "node scripts/build-map-assets.mjs",
    "data:validate": "tsc --outDir /tmp/ultreia-data-validate --module commonjs --noEmit false && NODE_PATH=./node_modules node -e \"const { validateCaminoDataPack } = require('/tmp/ultreia-data-validate/src/data/camino'); const issues = validateCaminoDataPack(); console.log(JSON.stringify({ issueCount: issues.length, firstIssues: issues.slice(0, 10) }, null, 2)); if (issues.length) process.exit(1);\"",
    "foundry:gateway": "node scripts/foundry-gateway.mjs",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
